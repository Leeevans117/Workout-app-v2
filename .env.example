# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: OAuth 2.0 credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# FITBIT_CLIENT_ID & FITBIT_CLIENT_SECRET: Optional Fitbit OAuth 2.0 credentials
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
