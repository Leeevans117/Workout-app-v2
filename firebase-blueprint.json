{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User fitness profile, personal targets, strength levels, weight progress, and objective preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "primaryObjective": {
          "type": "string",
          "description": "Primary fitness objective used to align workout recommendations.",
          "enum": ["strength", "weight_loss", "spine_hygiene", "endurance", "athletic_hybrid"]
        },
        "currentWeightKg": {
          "type": "number",
          "description": "Current body weight in kilograms."
        },
        "startWeightKg": {
          "type": "number",
          "description": "Starting body weight in kilograms when goal was set."
        },
        "targetWeightKg": {
          "type": "number",
          "description": "Target body weight in kilograms."
        },
        "currentStrengthLevel": {
          "type": "string",
          "description": "Current strength tier.",
          "enum": ["beginner", "intermediate", "advanced", "elite"]
        },
        "targetStrengthLevel": {
          "type": "string",
          "description": "Target strength tier.",
          "enum": ["beginner", "intermediate", "advanced", "elite"]
        },
        "currentMaxPullUps": {
          "type": "number",
          "description": "Current max pull-ups in a single session or set."
        },
        "targetMaxPullUps": {
          "type": "number",
          "description": "Target max pull-ups."
        },
        "currentMaxPushUps": {
          "type": "number",
          "description": "Current max strict push-ups."
        },
        "targetMaxPushUps": {
          "type": "number",
          "description": "Target max strict push-ups."
        },
        "dailyStepGoal": {
          "type": "number",
          "description": "Daily step goal (default 8000)."
        },
        "weeklyWorkoutGoal": {
          "type": "number",
          "description": "Target workouts completed per week."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update server timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "primaryObjective",
        "currentWeightKg",
        "startWeightKg",
        "targetWeightKg",
        "currentStrengthLevel",
        "targetStrengthLevel",
        "currentMaxPullUps",
        "targetMaxPullUps",
        "currentMaxPushUps",
        "targetMaxPushUps",
        "dailyStepGoal",
        "weeklyWorkoutGoal",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing the user's private email address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address.",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update server timestamp."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "ProgressSnapshot": {
      "title": "ProgressSnapshot",
      "description": "Historical body weight and strength benchmark check-in entry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateStr": {
          "type": "string",
          "description": "Local date string YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10
        },
        "weightKg": {
          "type": "number",
          "description": "Logged body weight in kg."
        },
        "maxPullUps": {
          "type": "number",
          "description": "Logged pull-up benchmark."
        },
        "maxPushUps": {
          "type": "number",
          "description": "Logged push-up benchmark."
        },
        "note": {
          "type": "string",
          "description": "Short progress note.",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        }
      },
      "required": ["uid", "dateStr", "weightKg", "maxPullUps", "maxPushUps", "note", "createdAt"]
    },
    "WorkoutLog": {
      "title": "WorkoutLog",
      "description": "Completed workout session log entry stored per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "description": "Unique workout log ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "description": "Local date string YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10
        },
        "routineId": {
          "type": "string",
          "description": "ID of the workout routine completed.",
          "maxLength": 120
        },
        "routineTitle": {
          "type": "string",
          "description": "Display title of the completed workout routine.",
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Workout category.",
          "enum": ["mcgill", "strength", "cardio", "mobility"]
        },
        "durationSeconds": {
          "type": "number",
          "description": "Total duration in seconds."
        },
        "completedExercisesCount": {
          "type": "number",
          "description": "Number of exercises completed."
        },
        "cardioMode": {
          "type": "string",
          "description": "Cardio modality or empty string.",
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "description": "Session notes.",
          "maxLength": 500
        },
        "timestamp": {
          "type": "number",
          "description": "Epoch milliseconds when logged."
        },
        "source": {
          "type": "string",
          "description": "Origin of log (manual or fitbit).",
          "enum": ["manual", "fitbit"]
        },
        "fitbitLogId": {
          "type": "string",
          "description": "Fitbit/Google Health activity ID if synced.",
          "maxLength": 128
        },
        "caloriesBurned": {
          "type": "number",
          "description": "Estimated or synced calories burned."
        },
        "averageHeartRate": {
          "type": "number",
          "description": "Average heart rate in BPM."
        },
        "steps": {
          "type": "number",
          "description": "Steps recorded during session."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "uid",
        "id",
        "date",
        "routineId",
        "routineTitle",
        "category",
        "durationSeconds",
        "completedExercisesCount",
        "cardioMode",
        "notes",
        "timestamp",
        "source",
        "fitbitLogId",
        "caloriesBurned",
        "averageHeartRate",
        "steps",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserRoutinesState": {
      "title": "UserRoutinesState",
      "description": "Stores user-customized default routines and custom routines built in the studio.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "routines": {
          "type": "array",
          "description": "Built-in workout routines customized by the user (up to 20)."
        },
        "customRoutines": {
          "type": "array",
          "description": "Custom workout routines created in Build Your Own Studio (up to 50)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update server timestamp."
        }
      },
      "required": ["uid", "routines", "customRoutines", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores a user's fitness profile, personal targets, and strength/weight objectives."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII storage for the user's private email."
    },
    "/users/{userId}/progressSnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/ProgressSnapshot" },
      "description": "Historical check-in snapshots tracking weight and strength progress toward goals."
    },
    "/users/{userId}/workoutLogs/{logId}": {
      "schema": { "$ref": "#/entities/WorkoutLog" },
      "description": "User workout logs persisted across browser cache clears and devices."
    },
    "/users/{userId}/appData/{docId}": {
      "schema": { "$ref": "#/entities/UserRoutinesState" },
      "description": "Stores the user's routines and custom routines state."
    }
  }
}
