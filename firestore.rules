rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidObjective(val) {
      return val is string && val in ['strength', 'weight_loss', 'spine_hygiene', 'endurance', 'athletic_hybrid'];
    }

    function isValidStrengthTier(val) {
      return val is string && val in ['beginner', 'intermediate', 'advanced', 'elite'];
    }

    // Blueprint Validator: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'primaryObjective',
        'currentWeightKg',
        'startWeightKg',
        'targetWeightKg',
        'currentStrengthLevel',
        'targetStrengthLevel',
        'currentMaxPullUps',
        'targetMaxPullUps',
        'currentMaxPushUps',
        'targetMaxPushUps',
        'dailyStepGoal',
        'weeklyWorkoutGoal',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'primaryObjective',
        'currentWeightKg',
        'startWeightKg',
        'targetWeightKg',
        'currentStrengthLevel',
        'targetStrengthLevel',
        'currentMaxPullUps',
        'targetMaxPullUps',
        'currentMaxPushUps',
        'targetMaxPushUps',
        'dailyStepGoal',
        'weeklyWorkoutGoal',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.uid == userId && data.uid == request.auth.uid &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
      isValidObjective(data.primaryObjective) &&
      data.currentWeightKg is number && data.currentWeightKg >= 20 && data.currentWeightKg <= 400 &&
      data.startWeightKg is number && data.startWeightKg >= 20 && data.startWeightKg <= 400 &&
      data.targetWeightKg is number && data.targetWeightKg >= 20 && data.targetWeightKg <= 400 &&
      isValidStrengthTier(data.currentStrengthLevel) &&
      isValidStrengthTier(data.targetStrengthLevel) &&
      data.currentMaxPullUps is number && data.currentMaxPullUps >= 0 && data.currentMaxPullUps <= 200 &&
      data.targetMaxPullUps is number && data.targetMaxPullUps >= 0 && data.targetMaxPullUps <= 200 &&
      data.currentMaxPushUps is number && data.currentMaxPushUps >= 0 && data.currentMaxPushUps <= 500 &&
      data.targetMaxPushUps is number && data.targetMaxPushUps >= 0 && data.targetMaxPushUps <= 500 &&
      data.dailyStepGoal is number && data.dailyStepGoal >= 1000 && data.dailyStepGoal <= 100000 &&
      data.weeklyWorkoutGoal is number && data.weeklyWorkoutGoal >= 1 && data.weeklyWorkoutGoal <= 14 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Blueprint Validator: UserPrivateInfo
    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid == userId && data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Blueprint Validator: ProgressSnapshot
    function isValidProgressSnapshot(data, userId) {
      return data.keys().hasAll([
        'uid',
        'dateStr',
        'weightKg',
        'maxPullUps',
        'maxPushUps',
        'note',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'dateStr',
        'weightKg',
        'maxPullUps',
        'maxPushUps',
        'note',
        'createdAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.uid == userId && data.uid == request.auth.uid &&
      data.dateStr is string && data.dateStr.size() == 10 &&
      data.weightKg is number && data.weightKg >= 20 && data.weightKg <= 400 &&
      data.maxPullUps is number && data.maxPullUps >= 0 && data.maxPullUps <= 200 &&
      data.maxPushUps is number && data.maxPushUps >= 0 && data.maxPushUps <= 500 &&
      data.note is string && data.note.size() <= 240 &&
      data.createdAt is timestamp;
    }

    // Blueprint Validator: WorkoutLog
    function isValidWorkoutLog(data, userId, logId) {
      return data.keys().hasAll([
        'uid',
        'id',
        'date',
        'routineId',
        'routineTitle',
        'category',
        'durationSeconds',
        'completedExercisesCount',
        'cardioMode',
        'notes',
        'timestamp',
        'source',
        'fitbitLogId',
        'caloriesBurned',
        'averageHeartRate',
        'steps',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'id',
        'date',
        'routineId',
        'routineTitle',
        'category',
        'durationSeconds',
        'completedExercisesCount',
        'cardioMode',
        'notes',
        'timestamp',
        'source',
        'fitbitLogId',
        'caloriesBurned',
        'averageHeartRate',
        'steps',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.uid == userId && data.uid == request.auth.uid &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
      data.id == logId &&
      data.date is string && data.date.size() == 10 &&
      data.routineId is string && data.routineId.size() >= 1 && data.routineId.size() <= 120 &&
      data.routineTitle is string && data.routineTitle.size() >= 1 && data.routineTitle.size() <= 160 &&
      data.category is string && data.category in ['mcgill', 'strength', 'cardio', 'mobility'] &&
      data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
      data.completedExercisesCount is number && data.completedExercisesCount >= 0 && data.completedExercisesCount <= 200 &&
      data.cardioMode is string && data.cardioMode.size() <= 32 &&
      data.notes is string && data.notes.size() <= 500 &&
      data.timestamp is number && data.timestamp >= 0 &&
      data.source is string && data.source in ['manual', 'fitbit'] &&
      data.fitbitLogId is string && data.fitbitLogId.size() <= 128 &&
      data.caloriesBurned is number && data.caloriesBurned >= 0 && data.caloriesBurned <= 20000 &&
      data.averageHeartRate is number && data.averageHeartRate >= 0 && data.averageHeartRate <= 300 &&
      data.steps is number && data.steps >= 0 && data.steps <= 250000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Blueprint Validator: UserRoutinesState
    function isValidUserRoutinesState(data, userId) {
      return data.keys().hasAll([
        'uid',
        'routines',
        'customRoutines',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'routines',
        'customRoutines',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.uid == userId && data.uid == request.auth.uid &&
      data.routines is list && data.routines.size() <= 20 &&
      (data.routines.size() == 0 || data.routines[0] is map) &&
      data.customRoutines is list && data.customRoutines.size() <= 50 &&
      (data.customRoutines.size() == 0 || data.customRoutines[0] is map) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 1. User Profile Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'primaryObjective',
          'currentWeightKg',
          'startWeightKg',
          'targetWeightKg',
          'currentStrengthLevel',
          'targetStrengthLevel',
          'currentMaxPullUps',
          'targetMaxPullUps',
          'currentMaxPushUps',
          'targetMaxPushUps',
          'dailyStepGoal',
          'weeklyWorkoutGoal',
          'createdAt',
          'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(userId);

      // 2. Isolated Private PII Subcollection
      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (exists(/databases/$(database)/documents/users/$(userId)) ||
           existsAfter(/databases/$(database)/documents/users/$(userId)));
        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'createdAt', 'updatedAt']) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      // 3. Progress Snapshots Subcollection (Weight & Strength Goal Check-ins)
      match /progressSnapshots/{snapshotId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(snapshotId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(snapshotId) &&
          isValidProgressSnapshot(incoming(), userId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(snapshotId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }

      // 4. Workout Logs Subcollection
      match /workoutLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(logId) &&
          isValidWorkoutLog(incoming(), userId, logId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (exists(/databases/$(database)/documents/users/$(userId)) ||
           existsAfter(/databases/$(database)/documents/users/$(userId)));
        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(logId) &&
          isValidWorkoutLog(incoming(), userId, logId) &&
          incoming().uid == existing().uid &&
          incoming().id == existing().id &&
          (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'date',
            'routineId',
            'routineTitle',
            'category',
            'durationSeconds',
            'completedExercisesCount',
            'cardioMode',
            'notes',
            'timestamp',
            'source',
            'fitbitLogId',
            'caloriesBurned',
            'averageHeartRate',
            'steps',
            'createdAt',
            'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(logId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }

      // 5. User Routines & Custom Routines State Subcollection
      match /appData/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'routinesState' &&
          isValidUserRoutinesState(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (exists(/databases/$(database)/documents/users/$(userId)) ||
           existsAfter(/databases/$(database)/documents/users/$(userId)));
        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'routinesState' &&
          isValidUserRoutinesState(incoming(), userId) &&
          incoming().uid == existing().uid &&
          (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'routines',
            'customRoutines',
            'createdAt',
            'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
